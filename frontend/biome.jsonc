{
   "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
   "root": false,
   "vcs": {
      "enabled": true,
      "clientKind": "git",
      "useIgnoreFile": true
   },
   "files": {
      "ignoreUnknown": false,
      "includes": ["**", "!dist", "!playwright-report", "!test-results", "!blob-report"]
   },
   "formatter": {
      "enabled": true,
      "indentStyle": "space",
      "indentWidth": 3,
      "lineWidth": 120
   },
   "linter": {
      "enabled": true,
      "rules": {
         "preset": "recommended",
         "a11y": "error",
         "style": {
            // These translate through Lingui's global instance; the app has one instance per locale.
            "noRestrictedImports": {
               "level": "error",
               "options": {
                  "paths": {
                     "@lingui/core/macro": {
                        "importNames": ["t", "plural", "select", "selectOrdinal"],
                        "message": "Use t from useLingui() (@lingui/react/macro), or msg resolved with a passed-in i18n: there is no global i18n instance."
                     },
                     "@lingui/core": {
                        "importNames": ["i18n"],
                        "message": "Get i18n from useLingui() or take it as a parameter: there is no global i18n instance."
                     }
                  }
               }
            }
         },
         "nursery": {
            "useTailwindSortedClasses": {
               "level": "warn",
               "fix": "safe"
            }
         }
      }
   },
   "javascript": {
      "formatter": {
         "quoteStyle": "double"
      }
   },
   "css": {
      "parser": {
         "tailwindDirectives": true
      }
   },
   "assist": {
      "enabled": true,
      "actions": {
         "source": {
            "organizeImports": "on"
         }
      }
   },
   "tailwind": { "mergeFunctions": ["twMerge", "tw"] }
}
